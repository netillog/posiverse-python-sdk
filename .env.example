# Copy to .env and fill in (never commit .env — it is gitignored).
# Shell/CI environment variables always override these values.
#
# Linux/macOS:  cp .env.example .env
# PowerShell:   Copy-Item .env.example .env
# cmd:          copy .env.example .env

# Required for PosiverseClient() and any live tests
POSIVERSE_API_KEY=

# Staff/bots only: https URL of an internal test OpenAPI.
# Leave unset (or empty) to use production.
POSIVERSE_BASE_URL=

# Live gates (never production). POSIVERSE_BASE_URL is required for live runs.
# POSIVERSE_LIVE_INTEGRATION=1
# POSIVERSE_LIVE_SMOKE=1
